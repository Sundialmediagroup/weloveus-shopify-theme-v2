{%- comment -%}
  Horizontal editorial card: image on the left, text on the right, arrow at the
  inline end. Used by sections/feature-carousel.liquid.

  The whole card is the link when `url` is set; the title's link is stretched
  over the card (::after) so there is one tab stop and one accessible name.

  With a `collection` (a brand) or a `featured_product`, anything left blank
  is filled from it: the image (the product's, or the collection image or its
  first product's), the link and the title. A product wins over a collection;
  one that's sold out or deleted is skipped, so the card falls back to the
  collection or to what's set by hand.

  The link carries the product and collection it shows, for section_click.

  Accepts:
  - featured_product: {Object} Shopify product. Optional; fills the blanks
                below, and wins over `collection`. Not named `product`, which
                a product page already defines.
  - collection: {Object}  Shopify collection. Optional; fills the blanks below.
  - sort:       {String}  Optional. The `sort_by` the collection link opens with,
                or 'default' / blank for the store's default sort.
  - image:      {Object}  Shopify image. Placeholder when blank.
  - title:      {String}  Required unless `collection` or `featured_product`
                is given.
  - url:        {String}  Optional. Makes the card a link.
  - background: {String}  Colour for the text panel. Default: --color-bg-feature.
  - cta:        {String}  Optional. The promo layout (text-banner): no panel
                colour, the title at the top and this label with the arrow at
                the bottom, instead of the arrow beside the title.
  - lazy:       {Boolean} Lazy-load the image. Default: true
{%- endcomment -%}

{%- liquid
  assign card_image = image
  assign card_title = title
  assign card_url = url

  assign card_product = nil
  assign card_collection = nil
  if featured_product != blank and featured_product.available
    assign card_product = featured_product
  elsif collection != blank
    assign card_collection = collection
  endif

  if card_product != blank
    if url == blank
      assign card_url = card_product.url
    endif
    assign card_image = image | default: card_product.featured_image
    assign card_title = title | default: card_product.title
  elsif card_collection != blank
    # Same default sort the header's brand links carry: main-collection
    # redirects a collection URL without `sort_by`, costing a second render.
    # A promo can pick its own instead.
    assign card_sort = settings.collection_default_sort | default: 'best-selling'
    if sort != blank and sort != 'default'
      assign card_sort = sort
    endif
    if url == blank
      assign card_url = card_collection.url | append: '?sort_by=' | append: card_sort
    endif
    # featured_image falls back to the first product's image, so a brand
    # with no collection image still gets a picture.
    assign card_image = image | default: card_collection.featured_image

    assign card_title = title | default: card_collection.title
  endif

  assign card_lazy = lazy | default: true
  assign loading_attr = 'lazy'
  unless card_lazy
    assign loading_attr = 'eager'
  endunless
-%}

{%- if card_title != blank -%}
  <article
    class="feature-card{% if card_url != blank %} feature-card--link{% endif %}{% if cta != blank %} feature-card--cta{% endif %}"
    {% if background != blank %}style="--feature-card-bg: {{ background }};"{% endif %}
  >
    <div class="feature-card__media">
      {%- if card_image != blank -%}
        {{- card_image | image_url: width: 900 | image_tag:
          class: 'feature-card__image',
          alt: card_image.alt | default: card_title,
          loading: loading_attr,
          sizes: '(min-width: 990px) 25vw, 45vw',
          widths: '300, 450, 600, 900',
          width: card_image.width,
          height: card_image.height
        -}}
      {%- else -%}
        {{- 'image' | placeholder_svg_tag: 'feature-card__image feature-card__placeholder' -}}
      {%- endif -%}
    </div>

    <div class="feature-card__body">
      <div class="feature-card__text">
        <h3 class="feature-card__title">
          {%- if card_url != blank -%}
            <a
              class="feature-card__link"
              href="{{ card_url }}"
              data-card="feature-card"
              {% if card_product != blank %}data-card-product="{{ card_product.handle }}"{% endif %}
              {% if card_collection != blank %}data-card-collection="{{ card_collection.handle }}"{% endif %}
            >{{ card_title | escape }}</a>
          {%- else -%}
            {{- card_title | escape -}}
          {%- endif -%}
        </h3>
      </div>

      {%- if cta != blank -%}
        <span class="feature-card__cta">
          {{- cta | escape -}}
          {%- if card_url != blank -%}
            <span class="feature-card__arrow">{%- render 'icon', name: 'arrow-right' -%}</span>
          {%- endif -%}
        </span>
      {%- elsif card_url != blank -%}
        <span class="feature-card__arrow">{%- render 'icon', name: 'arrow-right' -%}</span>
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
