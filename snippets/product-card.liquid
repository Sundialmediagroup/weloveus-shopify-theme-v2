{%- comment -%}
  Renders a product card.

  Accepts:
  - product:      {Object}  Shopify product object (required)
  - lazy:         {Boolean} Lazy-load the image. Default: true
  - show_vendor:  {Boolean} Show vendor name. Default: true
  - image_ratio:  {String}  CSS aspect-ratio value. Default: '1 / 1'
  - show_sold_out: {Boolean} Say "Sold out" beside the price when nothing is
                            available. Default: false. For lists the shopper
                            built themselves (the wishlist), where a sold-out
                            product still belongs but shouldn't look buyable.
  - sizes:        {String}  `sizes` attribute for the srcset. Default assumes a
                            2 / 3 / 4 column grid. Always pass the real value
                            when the layout differs — a card is never 100vw, and
                            100vw is what the browser assumes when `sizes` is
                            missing, so it downloads the 1000px source for a
                            ~380px slot.
{%- endcomment -%}

{%- liquid
  # allow_false — without it `lazy: false` falls through to the default and
  # every card lazy-loads, including the one that is the LCP element.
  assign lazy         = lazy        | default: true, allow_false: true
  assign show_vendor  = show_vendor | default: true
  assign image_ratio  = image_ratio | default: '1 / 1'
  assign card_sizes   = sizes       | default: '(min-width: 990px) 25vw, (min-width: 640px) 33vw, 50vw'

  if lazy
    assign loading_attr = 'lazy'
  else
    assign loading_attr = 'eager'
  endif

  assign card_image = product.featured_image
  assign image_alt = card_image.alt | default: product.title | escape

  # Sales. `product.price` and `compare_at_price` are both the lowest across the
  # variants, so a sale on any but the cheapest wouldn't show. The variants are
  # only looped when a compare-at price beats the lowest price, which no
  # variant can be on sale without. Sold-out variants don't count.
  # sale_state: '' (none), 'all' (every available variant) or 'some'.
  assign sale_state = ''
  if product.compare_at_price_max > product.price_min
    assign available_count = 0
    assign sale_count = 0
    assign lowest_price = nil
    # Option values as `~<position>:<value>~`, as on the product page.
    assign sale_values = ''
    assign full_values = ''
    for v in product.variants
      unless v.available
        continue
      endunless
      assign available_count = available_count | plus: 1
      if available_count == 1
        assign lowest_price = v.price
      elsif v.price < lowest_price
        assign lowest_price = v.price
      endif
      if v.compare_at_price > v.price
        assign sale_count = sale_count | plus: 1
        if sale_count == 1
          assign sale_variant = v
        elsif v.price < sale_variant.price
          assign sale_variant = v
        endif
        for opt in v.options
          assign sale_values = sale_values | append: '~' | append: forloop.index | append: ':' | append: opt | append: '~'
        endfor
      else
        for opt in v.options
          assign full_values = full_values | append: '~' | append: forloop.index | append: ':' | append: opt | append: '~'
        endfor
      endif
    endfor

    if sale_count > 0
      if sale_count == available_count
        assign sale_state = 'all'
      else
        assign sale_state = 'some'
      endif
    endif
  endif

  # The lowest price. `product.price` counts sold-out variants too, so where the
  # variants were looped anyway, the lowest one in stock instead; with every
  # variant on sale, the cheapest sale variant's.
  if sale_state == 'all'
    assign card_price = sale_variant.price | money
  elsif lowest_price != nil
    assign card_price = lowest_price | money
  else
    assign card_price = product.price | money
  endif
  if product.price_varies
    assign card_price = 'products.product.price_from' | t: price: card_price
  endif
-%}

<a
  class="product-card"
  href="{{ product.url }}"
  aria-label="{{ product.title | escape }}"
  data-item
  data-card="product-card"
  {% render 'item-data', product: product, on_sale: sale_state %}
>

  <div class="product-card__media" style="--card-ratio: {{ image_ratio }};">
    {%- comment -%}
      Quick-add only where there is genuinely nothing to choose. For a
      multi-variant product, adding an arbitrary size or colour is a returns
      problem, so the card falls through to its link and the PDP handles it.
    {%- endcomment -%}
    {%- assign first_variant = product.first_available_variant -%}
    {%- if product.has_only_default_variant and first_variant != blank -%}
      <span
        class="product-card__add-sticker"
        data-add-to-cart="{{ first_variant.id }}"
        role="button"
        aria-label="Add {{ product.title | escape }} to cart"
      >Add to<br>Cart</span>
    {%- endif -%}
    {%- render 'wishlist-button', product: product, context: 'card' -%}
    {%- if card_image != blank -%}
      {{
        card_image
        | image_url: width: 1000
        | image_tag:
          class: 'product-card__image',
          alt: image_alt,
          loading: loading_attr,
          sizes: card_sizes,
          widths: '200, 300, 400, 600, 800, 1000',
          width: card_image.width,
          height: card_image.height
      }}
    {%- else -%}
      <div class="product-card__placeholder">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">{{ product.title }}</h3>
    <div class="product-card__price">
      {%- if sale_state == 'all' -%}
        <span class="product-card__price-sale">{{ card_price }}</span>
        <s class="product-card__price-compare">{{ sale_variant.compare_at_price | money }}</s>
      {%- else -%}
        <span class="product-card__price-regular">{{ card_price }}</span>
      {%- endif -%}
      {%- if show_sold_out and product.available == false -%}
        <span class="product-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
    {%- if sale_state == 'some' -%}
      <p class="product-card__sale-note">
        {%- render 'sale-note', product: product, sale_values: sale_values, full_values: full_values -%}
      </p>
    {%- endif -%}
  </div>

</a>
