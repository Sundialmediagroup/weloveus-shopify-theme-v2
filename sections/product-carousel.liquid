{%- comment -%}
  Merchandising slider for a chosen collection. The markup lives in
  snippets/product-carousel.liquid so this, the PDP brand slider and the
  recommendations section all behave identically.
{%- endcomment -%}

{%- liquid
  assign source = collections[section.settings.collection]

  # Heading defaults to the chosen collection's title; a typed one overrides
  # it. Not "All products" when the fallback below kicks in, though: that
  # isn't what the merchant picked.
  assign heading = section.settings.heading
  if heading == blank and source != blank and source.products_count > 0
    assign heading = source.title | escape
  endif

  if source == blank or source.products_count == 0
    assign source = collections.all
  endif

  # Built here, not inline: `render` arguments do not evaluate filters.
  assign heading_id = 'carousel-heading-' | append: section.id
-%}

{%- render 'product-carousel',
  products: source.products,
  heading: heading,
  heading_id: heading_id,
  list_id: 'product_carousel',
  limit: section.settings.products_to_show,
  cards_desktop: section.settings.cards_desktop,
  cards_mobile: section.settings.cards_mobile
-%}

{% schema %}
{
  "name": "Product Carousel",
  "class": "section-type--product-carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 2,
      "label": "Cards in view — desktop"
    },
    {
      "type": "range",
      "id": "cards_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Cards in view — mobile"
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}
