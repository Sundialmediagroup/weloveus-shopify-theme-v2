{%- comment -%}
  Product recommendations.

  Rendered empty on first paint and filled in from
  `/recommendations/products?section_id=…` when the section scrolls into view,
  which is the only way Shopify exposes recommendations to the storefront.
  Reuses the shared carousel snippet so it matches the rest of the theme.

  Same-brand products are filtered out here rather than in the request — the
  recommendations API takes no vendor parameter. Because that filtering happens
  after the response, the request asks for the API maximum of 10 and the
  setting then caps how many survivors are shown, so trimming the brand's own
  products does not leave the slider short.
{%- endcomment -%}

{%- comment -%}
  Built here, not inline: `render` arguments do not evaluate filters.
{%- endcomment -%}
{%- assign heading_id = 'recommendations-heading-' | append: section.id -%}

<product-recommendations
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- render 'product-carousel',
      products: recommendations.products,
      heading: section.settings.heading,
      heading_id: heading_id,
      exclude_vendor: product.vendor,
      limit: section.settings.products_to_show,
      cards_desktop: section.settings.cards_desktop,
      cards_mobile: section.settings.cards_mobile,
      overhang: section.settings.overhang
    -%}
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "default": "related",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "info": "Complementary products are set per product in the Search & Discovery app."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Cards in view — desktop"
    },
    {
      "type": "range",
      "id": "cards_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Cards in view — mobile"
    },
    {
      "type": "range",
      "id": "overhang",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 60,
      "label": "Peek amount (px)",
      "info": "How much of the next card is visible at the right edge"
    }
  ]
}
{% endschema %}
