{%- comment -%}
  The latest posts from one blog, as a feed of article cards
  (snippets/article-card.liquid): one column on mobile, up to three from `lg`.

  With no blog chosen, the theme editor shows placeholder cards and the live
  site renders nothing.

  Accepts (via section settings):
  - heading:         {String}  Optional.
  - blog:            {Blog}
  - limit:           {Number}  Posts to show.
  - columns_desktop: {String}  '1' – '3'.
  - image_ratio:     {String}  CSS aspect-ratio, or 'natural'.
  - show_image:      {Boolean}
  - show_view_all:   {Boolean} Link to the blog under the feed.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign feed_blog = blogs[s.blog]
  assign heading_id = 'article-feed-heading-' | append: section.id
  assign has_articles = false
  if feed_blog != blank and feed_blog.articles_count > 0
    assign has_articles = true
  endif
-%}

{%- if has_articles or request.design_mode -%}
  <section
    class="article-feed stack"
    style="--article-feed-cols: {{ s.columns_desktop }};"
    {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  >
    {%- if s.heading != blank -%}
      <h2 class="article-feed__heading" id="{{ heading_id }}">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <ul class="article-feed__list">
      {%- if has_articles -%}
        {%- for article in feed_blog.articles limit: s.limit -%}
          <li class="article-feed__item">
            {%- render 'article-card',
              article: article,
              image_ratio: s.image_ratio,
              show_image: s.show_image,
              lazy: true
            -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="article-feed__item">
            {%- render 'article-card', image_ratio: s.image_ratio, show_image: s.show_image -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.show_view_all and has_articles and feed_blog.articles_count > s.limit -%}
      <a class="btn btn--secondary article-feed__view-all" href="{{ feed_blog.url }}">
        {{- 'sections.article_feed.view_all' | t -}}
      </a>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article feed",
  "class": "section-type--article-feed",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest stories"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "natural", "label": "Original" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Article feed"
    }
  ]
}
{% endschema %}
