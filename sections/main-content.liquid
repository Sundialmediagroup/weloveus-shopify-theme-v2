<div class="main-content">
  {%- if section.settings.heading != blank -%}
    <h1 class="main-content__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="main-content__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main Content",
  "tag": "section",
  "class": "main-content-section section-type--main-content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WeLoveUs"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "presets": [
    {
      "name": "Main Content"
    }
  ]
}
{% endschema %}
