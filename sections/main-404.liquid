{%- comment -%}
  Not found. The page header every other page has — title over a subtle rule,
  start-aligned — then a line of explanation and the way home.
{%- endcomment -%}

<div class="main-404">
  <header class="main-404__header">
    <p class="main-404__code">404</p>
    <h1>{{ 'templates.404.title' | t }}</h1>
  </header>
  <p class="main-404__text">{{ 'templates.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg main-404__cta">
    {{- 'templates.404.homepage' | t -}}
  </a>
</div>

{% schema %}
{
  "name": "404",
  "tag": "section"
}
{% endschema %}
