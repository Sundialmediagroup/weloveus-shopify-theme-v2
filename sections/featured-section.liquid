{%- comment -%}
  Two horizontal cards across the full width, side by side from `md` and
  stacked below it. Each card has the image on one half and its own colour
  panel on the other, holding the title, an optional line of text and the CTA,
  one under the other. The whole card is one link.

  Each card links to a collection or a product (the product wins when both are
  set). The image, link and title come from that, and anything set on the
  block overrides it. On a collection link, the URL carries the default sort,
  as the header's brand links do: main-collection redirects a collection URL
  without `sort_by`, which costs a second render.

  The theme editor shows a placeholder title and image for a new card, so it
  can be clicked and set up. A card with nothing to show is left out of the
  live site.
{%- endcomment -%}

{%- liquid
  assign default_sort = settings.collection_default_sort | default: 'best-selling'
-%}

{%- if section.blocks.size > 0 -%}
  <div class="featured-section">
    {%- for block in section.blocks -%}
      {%- liquid
        assign s = block.settings
        assign card_product = s.product
        assign card_collection = s.collection

        assign card_image = s.image
        assign card_title = s.title
        assign card_url = s.url
        if card_product != blank
          assign card_image = card_image | default: card_product.featured_image
          assign card_title = card_title | default: card_product.title
          if card_url == blank
            assign card_url = card_product.url
          endif
        elsif card_collection != blank
          assign card_image = card_image | default: card_collection.featured_image
          assign card_title = card_title | default: card_collection.title
          if card_url == blank
            assign card_url = card_collection.url | append: '?sort_by=' | append: default_sort
          endif
        endif

        if request.design_mode and card_title == blank
          assign card_title = 'sections.featured_section.placeholder_title' | t
        endif

        assign card_cta = s.cta
        if card_cta == blank
          assign card_cta = 'sections.feature_card.cta' | t
        endif
      -%}

      {%- if card_title != blank -%}
        <article
          class="featured-card{% if card_url != blank %} featured-card--link{% endif %}"
          style="{% if s.background_color != blank %}--featured-card-bg: {{ s.background_color }};{% endif %}{% if s.text_color != blank %} --featured-card-color: {{ s.text_color }};{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="featured-card__media">
            {%- if card_image != blank -%}
              {{- card_image | image_url: width: 1200 | image_tag:
                class: 'featured-card__image',
                alt: card_image.alt | default: card_title,
                loading: 'lazy',
                sizes: '(min-width: 768px) 25vw, 50vw',
                widths: '300, 450, 600, 900, 1200'
              -}}
            {%- else -%}
              {{- 'image' | placeholder_svg_tag: 'featured-card__image featured-card__placeholder' -}}
            {%- endif -%}
          </div>

          <div class="featured-card__body">
            <div class="featured-card__text">
              <h2 class="featured-card__title">
                {%- if card_url != blank -%}
                  <a class="featured-card__link" href="{{ card_url }}" data-card="featured-card">{{ card_title | escape }}</a>
                {%- else -%}
                  {{- card_title | escape -}}
                {%- endif -%}
              </h2>

              {%- if s.text != blank -%}
                <p class="featured-card__copy">{{ s.text | escape }}</p>
              {%- endif -%}
            </div>

            {%- if card_url != blank -%}
              <span class="featured-card__cta">
                {{- card_cta | escape -}}
                <span class="featured-card__arrow">{%- render 'icon', name: 'arrow-right' -%}</span>
              </span>
            {%- endif -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured Section",
  "class": "section-type--featured-section",
  "tag": "section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Fills the image, link and title. Anything set below overrides it."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Used instead of the collection when both are set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Leave blank to use the collection or product name."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Optional. A line or two under the title."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link override"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text",
          "info": "Leave blank for “Shop now”."
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Panel colour",
          "default": "#8b2a2a"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Section",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
