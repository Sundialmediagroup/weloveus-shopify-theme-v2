{%- comment -%}
  Statement banner: text, then an image beside it, and up to two promo cards
  stacked at the far end. The image is cropped to the text's height, so the two
  start and end together. Below `md` everything stacks, text first.

  Type size is fixed by the design system, not the merchant — it sits on the
  type scale a step above body copy (--text-xl) and scales fluidly up to
  --text-4xl on desktop, so it always reads as a statement without shouting.

  Accepts (via section settings):
  - text:             {String} Statement copy. Line breaks are preserved.
  - background_color: {Color}
  - text_color:       {Color}
  - url:              {String} Optional. Makes the text and image clickable.
  - image:            {Image}  Optional. Beside the text; a placeholder stands
                      in for it in the theme editor, and the space stays empty
                      on the live site until one is chosen.

  Blocks:
  - promo (up to 2): snippets/promo-cards.liquid. With none, the banner is
    text and image only.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign banner_text = s.text | escape | newline_to_br
  assign has_promos = false
  if section.blocks.size > 0
    assign has_promos = true
  endif
-%}

{%- if s.text != blank -%}
  {%- capture banner_style -%}--tb-bg: {{ s.background_color }}; --tb-color: {{ s.text_color }};{%- endcapture -%}

  {%- capture banner_media -%}
    <div class="text-banner__media">
      {%- if s.image != blank -%}
        {{- s.image | image_url: width: 1800 | image_tag:
          class: 'text-banner__image',
          sizes: '(min-width: 768px) 50vw, 100vw',
          widths: '600, 900, 1200, 1500, 1800',
          loading: 'lazy'
        -}}
      {%- elsif request.design_mode -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'text-banner__placeholder' -}}
      {%- endif -%}
    </div>
  {%- endcapture -%}

  <div class="text-banner{% if has_promos %} text-banner--promos{% endif %}" style="{{ banner_style }}">
    {%- if s.url != blank -%}
      <a class="text-banner__main text-banner__main--link" href="{{ s.url }}">
        <span class="text-banner__text">{{ banner_text }}</span>
        {{- banner_media -}}
      </a>
    {%- else -%}
      <div class="text-banner__main">
        <h2 class="text-banner__text">{{ banner_text }}</h2>
        {{- banner_media -}}
      </div>
    {%- endif -%}

    {%- if has_promos -%}
      {%- render 'promo-cards', blocks: section.blocks, class: 'text-banner__promos' -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Text Banner",
  "class": "section-type--text-banner",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Line breaks are preserved.",
      "default": "We love us"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link",
      "info": "Optional. Makes the text and image clickable."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown beside the text, cropped to its height."
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Optional. Fills the image, link and title from the product, and wins over the collection. Anything set below overrides it."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Fills the image, link and title from the collection — anything set below overrides it. Used when there's no product, or it's sold out."
        },
        {
          "type": "select",
          "id": "sort",
          "label": "Collection sort",
          "info": "How the collection opens when the promo is clicked. Not used with a product or a link set below.",
          "default": "default",
          "options": [
            { "value": "default", "label": "Store default" },
            { "value": "best-selling", "label": "Trending" },
            { "value": "created-descending", "label": "Latest arrivals" },
            { "value": "price-ascending", "label": "Price: Low to high" },
            { "value": "price-descending", "label": "Price: High to low" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Leave blank to use the product or collection name."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text",
          "info": "Leave blank for “Shop now”."
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Text background",
          "info": "Leave blank for none."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Banner"
    }
  ]
}
{% endschema %}
