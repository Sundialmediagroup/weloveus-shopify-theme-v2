[
  {
    "name": "theme_info",
    "theme_name": "WeLoveUs v2",
    "theme_version": "2.0.0",
    "theme_author": "WeLoveUs",
    "theme_documentation_url": "https://weloveus.com",
    "theme_support_url": "https://weloveus.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Foreground",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#0a0a0a"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 10,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      }
    ]
  },
  {
    "name": "Collection",
    "settings": [
      {
        "type": "select",
        "id": "collection_default_sort",
        "label": "Default sort order",
        "info": "Applied to every collection. Lives here rather than on the section because the category sidebar and the header brand menu build it into their links — a collection URL that arrives without it gets redirected, which renders the page twice.",
        "default": "best-selling",
        "options": [
          {
            "value": "best-selling",
            "label": "Best selling"
          },
          {
            "value": "created-descending",
            "label": "Newest"
          },
          {
            "value": "price-ascending",
            "label": "Price: low to high"
          },
          {
            "value": "price-descending",
            "label": "Price: high to low"
          },
          {
            "value": "title-ascending",
            "label": "A–Z"
          },
          {
            "value": "manual",
            "label": "Manual"
          }
        ]
      },
      {
        "type": "select",
        "id": "collection_all_default_sort",
        "label": "All products sort order",
        "info": "Overrides the default above for the All products page (/collections/all).",
        "default": "created-descending",
        "options": [
          {
            "value": "best-selling",
            "label": "Best selling"
          },
          {
            "value": "created-descending",
            "label": "Newest"
          },
          {
            "value": "price-ascending",
            "label": "Price: low to high"
          },
          {
            "value": "price-descending",
            "label": "Price: high to low"
          },
          {
            "value": "title-ascending",
            "label": "A–Z"
          }
        ]
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      }
    ]
  },
  {
    "name": "Essie chat",
    "settings": [
      {
        "type": "checkbox",
        "id": "essie_enabled",
        "label": "Show Ask Essie chat",
        "default": true
      },
      {
        "type": "text",
        "id": "essie_api_base",
        "label": "API base URL",
        "info": "/apps/weloveus on the shop (Shopify's app proxy). For local development, the e360 API's URL, e.g. http://127.0.0.1:8765. No trailing slash.",
        "default": "/apps/weloveus"
      }
    ]
  },
  {
    "name": "Analytics & experiments",
    "settings": [
      {
        "type": "paragraph",
        "content": "Holdouts hide a feature from a share of visitors so its effect on conversion and order value can be measured against those who see it. Leave at 0% when no test is running. Change a percentage between tests, not during one."
      },
      {
        "type": "range",
        "id": "holdout_essie",
        "label": "Ask Essie holdout",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "%",
        "default": 0
      },
      {
        "type": "range",
        "id": "holdout_quick_add",
        "label": "Quick add holdout",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "%",
        "default": 0
      },
      {
        "type": "range",
        "id": "holdout_shop_the_story",
        "label": "Shop the story holdout",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "%",
        "default": 0
      }
    ]
  }
]
