{% doc %}
  @prompt
    I want to create a block that has the image on the left and the text on the right, the image on the right should be connected to the Founder photo metafield and the text should be connected to the foubder note metafield. This should be diffrent for each brand collection as some may have those metfields filled some may not, do not dispaly until is filled however, Can we make sure the image block is scaled down to meet the size of the text, so there isnt too much white space around the text, Can we make sure the image scales with the text, so that the image isnat much bigger than the text there shoudlnt bethis much space from , Can we add a segement where we can either add a title and override the text or image if possible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign founder_photo_field = collection.metafields.custom.founder_photo %}
{% assign founder_note_field = collection.metafields.custom.founder_note %}
{% assign founder_photo = block.settings.photo_override | default: founder_photo_field.value %}
{% assign founder_note = block.settings.note_override %}
{% if founder_note == blank %}
  {% assign founder_note = founder_note_field.value %}
{% endif %}
{% assign founder_heading = block.settings.heading %}
{% if founder_heading == blank %}
  {% assign founder_heading = collection.title %}
{% endif %}
{% if founder_photo != blank or founder_note != blank %}
  {% style %}
    .ai-founder-story-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      margin-inline: auto;
      color: {{ block.settings.text_color }};
      background: {{ block.settings.background_color }};
    }
    .ai-founder-story-{{ ai_gen_id }}__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: {{ block.settings.column_gap }}px;
      width: 100%;
    }
    .ai-founder-story-{{ ai_gen_id }}__media {
      min-width: 0;
      line-height: 0;
      text-align: center;
    }
    .ai-founder-story-{{ ai_gen_id }}__media img {
      display: block;
      width: 100%;
      max-height: 420px;
      height: auto;
      object-fit: contain;
      margin: 0 auto;
    }
    .ai-founder-story-{{ ai_gen_id }}__copy {
      min-width: 0;
      align-self: center;
    }
    .ai-founder-story-{{ ai_gen_id }}__heading {
      color: {{ block.settings.text_color }};
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
      font-weight: {{ block.settings.heading_font.weight }};
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.2;
      margin: 0 0 12px;
    }
    .ai-founder-story-{{ ai_gen_id }}__note {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.body_size }}px;
      line-height: 1.55;
    }
    .ai-founder-story-{{ ai_gen_id }}__note > *:first-child { margin-top: 0; }
    .ai-founder-story-{{ ai_gen_id }}__note > *:last-child { margin-bottom: 0; }
    @media screen and (max-width: 749px) {
      .ai-founder-story-{{ ai_gen_id }} { width: 100%; }
      .ai-founder-story-{{ ai_gen_id }}__inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }
      .ai-founder-story-{{ ai_gen_id }}__media img { max-height: 300px; }
    }
  {% endstyle %}
  <div class="ai-founder-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-founder-story-{{ ai_gen_id }}__inner">
      {% if founder_photo != blank %}
        <div class="ai-founder-story-{{ ai_gen_id }}__media">
          <img
            src="{{ founder_photo | image_url: width: 1200 }}"
            alt="{{ founder_photo.alt | default: founder_heading | escape }}"
            loading="lazy"
            width="{{ founder_photo.width }}"
            height="{{ founder_photo.height }}"
          >
        </div>
      {% endif %}
      {% if founder_note != blank or block.settings.heading != blank %}
        <div class="ai-founder-story-{{ ai_gen_id }}__copy">
          {% if founder_heading != blank %}
            <h2 class="ai-founder-story-{{ ai_gen_id }}__heading">{{ founder_heading | escape }}</h2>
          {% endif %}
          {% if founder_note != blank %}
            <div class="ai-founder-story-{{ ai_gen_id }}__note">{{ founder_note }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Founder story",
  "settings": [
    {
      "type": "header",
      "content": "Collection content"
    },
    {
      "type": "paragraph",
      "content": "Uses collection metafields custom.founder_photo and custom.founder_note. The block stays hidden when both are empty."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Optional overrides"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title override"
    },
    {
      "type": "image_picker",
      "id": "photo_override",
      "label": "Photo override"
    },
    {
      "type": "richtext",
      "id": "note_override",
      "label": "Note override"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Founder story"
    }
  ],
  "tag": null,
  "class": "founder-story-block"
}
{% endschema %}