{
  "name": "weloveus-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "theme:dev": "shopify theme dev",
    "start": "concurrently -n vite,shopify -c cyan,magenta \"vite build --watch\" \"shopify theme dev\"",
    "build": "vite build",
    "theme:push": "npm run build && shopify theme push",
    "theme:check": "shopify theme check"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "sass": "^1.77.0",
    "vite": "^5.4.0",
    "vite-plugin-shopify": "^4.0.2"
  }
}
